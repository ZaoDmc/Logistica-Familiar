{
  "name": "logistica-familiar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:db": "node scripts/test-database-local.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:db:remote": "node scripts/test-database-remote.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
    "auth:deploy": "node scripts/deploy-accounts.mjs",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
    "auth:recover-admin": "node scripts/recover-admin.mjs",
    "test:accounts:remote": "node scripts/test-accounts-remote.mjs",
    "test:inventory": "node --experimental-strip-types scripts/test-inventory-model.mjs",
    "inventory:qa": "node scripts/inventory-qa.mjs",
    "test:inventory:remote": "node scripts/test-inventory-remote.mjs",
    "test:sync": "node --experimental-strip-types scripts/test-inventory-sync.mjs",
    "test:sync:remote": "node --experimental-strip-types scripts/test-realtime-remote.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "web:deploy": "node scripts/deploy-web.mjs",
